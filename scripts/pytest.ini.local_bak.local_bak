[pytest]
# Playwright plugin auto-configures browser launch
testpaths = tests/
python_files = test_*.py
python_classes = Test*
python_functions = test_*

# Headless by default for CI — override with --headed for debugging
addopts = -v --headed --slowmo 200

# Prevent pytest from trying to collect fixtures as tests
norecursedirs = .git __pycache__ *.egg-info

# Markers
markers =
    smoke: Quick smoke tests for critical paths
    regression: Full regression suite
    p0: Priority 0 — blocking/critical
    p1: Priority 1 — important
    p2: Priority 2 — nice-to-have
    boundary: Boundary value tests
    security: Security tests (SQLi, XSS)
    cross_browser: Cross-browser compatibility tests
    api: API contract tests
    nfr: Non-functional requirements (performance, audit)
    chromium: Chromium browser tests
    firefox: Firefox browser tests
    webkit: WebKit (Safari) browser tests

# Python path — ensures pages/, config/, helpers/, utils/ are importable
pythonpath = pages config helpers utils